# Autodetecta texto y binario; el repo guarda LF, el checkout usa el fin de
# línea nativo del sistema. Evita diffs de fin de línea entre colaboradores.
* text=auto

# Fuentes y datos: LF siempre, para que los diffs sean estables entre sistemas.
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf

# Scripts y workflows de Windows conservan CRLF.
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binarios: nunca se normalizan ni se pasan por diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gguf binary
*.pt   binary
*.safetensors binary

# Catálogo sincronizado: generado, no autorado. GitHub lo contrae en los
# diffs y lo excluye de las estadísticas de lenguaje.
data/catalog_bootstrap.json linguist-generated=true
